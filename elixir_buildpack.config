# Gigalixir buildpack configuration.
# https://github.com/gigalixir/gigalixir-buildpack-elixir
elixir_version=1.20.4
erlang_version=29.1

# NOTE: no `release=true` here — the gigalixir-buildpack-releases buildpack
# generates the release; a second one from the elixir buildpack conflicts
# with it (per Gigalixir docs).

# Build + digest assets (tailwind, esbuild, phx.digest) after compilation.
# The mix-managed asset pipeline needs no Node on the build server.
hook_post_compile="mix assets.deploy"
