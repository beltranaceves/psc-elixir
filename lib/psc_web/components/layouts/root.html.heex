<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" type="image/svg+xml" href={~p"/images/favicon.svg"} />
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <meta name="theme-color" content="#f8f8f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#292f37" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="PSC" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <.live_title default="PSC" suffix=" · PSC">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <%!-- `min-h-dvh`, not `min-h-screen`: on a phone `100vh` is the *large*
  viewport (browser toolbars hidden) while the app is sized in `dvh` (the
  viewport as it is now). With `min-h-screen` the body was taller than the app
  by the height of the toolbar, so the page scrolled vertically and showed an
  empty strip under the app. --%>
  <body class="min-h-dvh flex flex-col bg-base-100 text-base-content">
    {@inner_content}
  </body>
</html>
